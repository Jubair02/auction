# Copy to .env and fill in. Never commit .env — it holds real credentials.

# PostgreSQL connection string (used by Next.js and the auction mini-service).
# Neon: use the pooled host (-pooler) and keep these options — the database
# sleeps when idle (connect_timeout) and the pooler needs pgbouncer=true:
#   ?sslmode=require&connect_timeout=15&pool_timeout=20&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connect_timeout=15&pool_timeout=20&pgbouncer=true"

# Signs session cookies and live-auction socket tokens. REQUIRED — the app
# refuses to sign or verify tokens without it. At least 32 random characters:
#   openssl rand -base64 48
# Use a different value per environment. Changing it logs everyone out.
AUCTION_SECRET=""

# Resend (https://resend.com) — sends password reset emails.
RESEND_API_KEY=""
# Sender address. Until you verify your domain in Resend, leave this unset:
# the default onboarding@resend.dev only delivers to your own Resend login email.
# RESEND_FROM="NeelamGhor <no-reply@your-domain.com>"

# Public base URL used in emailed links. REQUIRED in production (never taken
# from the request's Host header there); optional in development.
# APP_URL="https://neelamghor.com"

# Optional. Extra browser origins allowed to open live-auction sockets,
# comma-separated. The app's own origin (via the gateway) is always allowed.
# ALLOWED_ORIGINS="https://neelamghor.com,https://www.neelamghor.com"

# Optional. Where browsers reach the live auction service. Leave unset: pages
# served by Next on :3000 connect to :3003 on the same host, and pages behind
# the gateway use its ?XTransformPort=3003 route. Set it for a dedicated host,
# e.g. NEXT_PUBLIC_AUCTION_URL="wss://live.neelamghor.com"
# NEXT_PUBLIC_AUCTION_URL=""

# Optional (recommended in production). Slack / Discord incoming-webhook URL
# that receives an alert for server errors, browser crashes and auction-engine
# failures. Set it on the website AND the auction service. See DEPLOY.md.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Optional, auction service only. Database connections kept for live rooms
# (default 10). Daily SMS caps (defaults 5 per number, 500 per tournament,
# 5000 in total) — see DEPLOY.md → SMS notifications.
# AUCTION_DB_POOL_SIZE=10
# SMS_DAILY_LIMIT_PER_NUMBER=5
# SMS_DAILY_LIMIT_PER_TOURNAMENT=500
# SMS_DAILY_LIMIT_TOTAL=5000
