# Copy to .env and fill in. Never commit .env — it holds real credentials.

# PostgreSQL connection string (used by Next.js and the auction mini-service)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Signs session cookies and live-auction socket tokens. REQUIRED — the app
# refuses to sign or verify tokens without it. At least 32 random characters:
#   openssl rand -base64 48
# Use a different value per environment. Changing it logs everyone out.
AUCTION_SECRET=""

# Resend (https://resend.com) — sends password reset emails.
RESEND_API_KEY=""
# Sender address. Until you verify your domain in Resend, leave this unset:
# the default onboarding@resend.dev only delivers to your own Resend login email.
# RESEND_FROM="NeelamGhor <no-reply@your-domain.com>"

# Public base URL used in emailed links. REQUIRED in production (never taken
# from the request's Host header there); optional in development.
# APP_URL="https://neelamghor.com"

# Optional. Extra browser origins allowed to open live-auction sockets,
# comma-separated. The app's own origin (via the gateway) is always allowed.
# ALLOWED_ORIGINS="https://neelamghor.com,https://www.neelamghor.com"
