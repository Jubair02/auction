generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: status/role fields are plain strings (kept from the original SQLite schema) — not DB enums.

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  role           String    @default("ORGANIZER") // ADMIN | ORGANIZER | MANAGER
  status         String    @default("ACTIVE") // ACTIVE | BLOCKED
  // Embedded in every session cookie; bumping it (e.g. on password reset)
  // invalidates all of the user's existing sessions at once.
  sessionVersion Int       @default(0)
  // Set when the person deleted their account: personal fields are wiped and
  // the row stays only so audit records (bids, payments) keep a valid owner.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tournaments         Tournament[]
  managedTeams        Team[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  staffRoles          TournamentStaff[]
  payments            Payment[]
}

// Single-use password reset links. Only the SHA-256 of the token is stored,
// so a database leak cannot be turned into account takeovers.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tournament {
  id                String    @id @default(cuid())
  name              String
  sport             String    @default("CRICKET") // CRICKET | FOOTBALL | OTHER
  // OTHER only — which game it is and how it is played. Cricket/football use
  // the built-in roles and these stay empty.
  sportName         String? // e.g. Kabaddi, Volleyball
  playerRoles       String[]  @default([]) // e.g. Raider, Defender, All-rounder
  playersPerTeam    Int? // squad size; the default max squad for new teams
  playersOnField    Int? // how many play at once
  tournamentType    String? // Corporate Cricket, University Tournament, Local Club, School, Community, Indoor, 6-a-side...
  description       String?
  logoUrl           String?
  bannerUrl         String?
  location          String?
  startDate         DateTime?
  auctionAt         DateTime?
  auctionMode       String    @default("CATEGORY") // CATEGORY | NORMAL
  basePrice         Int       @default(10000) // used in NORMAL mode
  status            String    @default("DRAFT") // DRAFT | READY | LIVE | COMPLETED
  // Public self-registration link (#/register-player/<code>). The code is
  // random, not the tournament id, so it can be rotated if it leaks.
  registrationCode  String?   @unique
  registrationOpen  Boolean   @default(false)
  // Set instead of deleting once an auction has bids or audit events, so the
  // money trail (Bid / AuctionEvent cascade from Auction) is never destroyed.
  // Archived tournaments are hidden from organizers and their links stop working;
  // only an ADMIN can see them or delete them for good.
  archivedAt        DateTime?
  // Pricing: FREE tournaments have team/player limits and a watermark on the
  // stream overlay; PRO is unlocked per tournament by an approved Payment.
  plan              String    @default("FREE") // FREE | PRO
  proSince          DateTime?
  // Public results page (/results/:id) and share cards, once the auction ended.
  resultsPublic     Boolean   @default(true)
  // Optional player registration fee, paid straight to the organizer's own
  // bKash / Nagad number; the organizer verifies each Transaction ID.
  registrationFee   Int? // ৳; null = free
  feeBkashNumber    String?
  feeNagadNumber    String?
  feeInstructions   String?
  // SMS notifications (PRO): registration decisions, auction reminder, "you were sold".
  smsEnabled        Boolean   @default(false)
  smsLang           String    @default("bn") // bn | en
  // League (after the auction): fixture format and points rules. Null points =
  // sport defaults (cricket 2/1/0 with NRR, football 3/1/0 with goal difference).
  leagueFormat      String? // ROUND_ROBIN | DOUBLE_ROUND_ROBIN | GROUPS_KNOCKOUT | KNOCKOUT
  pointsWin         Int?
  pointsDraw        Int?
  pointsLoss        Int?
  oversPerInnings   Int? // cricket: a side bowled out counts the full quota for net run rate
  // Branding (PRO): accent colour and hiding NeelamGhor branding on public
  // pages, the stream overlay and share cards. Logo/banner already exist.
  brandColor        String?
  brandHidePlatform Boolean   @default(false)
  organizerId       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organizer     User                 @relation(fields: [organizerId], references: [id])
  players       Player[]
  teams         Team[]
  auction       Auction?
  registrations PlayerRegistration[]
  staff         TournamentStaff[]
  payments      Payment[]
  matches       Match[]
  sponsors      Sponsor[]

  // Postgres does not index foreign keys on its own.
  @@index([organizerId])
}

model Player {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  photoUrl     String?
  phone        String?
  role         String // Cricket: Batsman, Bowler, All-rounder, Wicketkeeper | Football: Goalkeeper, Defender, Midfielder, Forward
  category     String? // A | B | C | D | E (CATEGORY mode)
  basePrice    Int      @default(10000)
  previousTeam String?
  status       String   @default("AVAILABLE") // AVAILABLE | LIVE | SOLD | UNSOLD | SKIPPED
  playerNumber Int      @default(0)
  soldPrice    Int?
  soldToTeamId String?
  // Bumped every time the organizer re-auctions this player. Cycle 0 is the
  // first time they go under the hammer; bids and sales are tagged with the
  // cycle they belong to so each re-auction is a separate auction cycle.
  auctionCycle Int      @default(0)
  createdAt    DateTime @default(now())

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  soldToTeam Team?             @relation("soldPlayers", fields: [soldToTeamId], references: [id])
  matchStats MatchPlayerStat[]

  // Two imports racing for the next number must collide, not duplicate "#12".
  @@unique([tournamentId, playerNumber])
  @@index([tournamentId, status])
  @@index([soldToTeamId])
}

model Team {
  id              String    @id @default(cuid())
  tournamentId    String
  name            String
  logoUrl         String?
  color           String? // hex accent, e.g. #0F766E
  captainName     String?
  managerUserId   String?
  budget          Int       @default(1000000)
  maxSquad        Int       @default(14)
  // Manager invite link (#/invite/<token>): SHA-256 of the token only.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  minSquad        Int       @default(9)
  spent           Int       @default(0)
  groupName       String? // league group (A, B, …) for GROUPS_KNOCKOUT

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  manager     User?      @relation(fields: [managerUserId], references: [id])
  players     Player[]   @relation("soldPlayers")
  bids        Bid[]
  homeMatches Match[]    @relation("homeTeam")
  awayMatches Match[]    @relation("awayTeam")

  // One team per manager per tournament. Enforced here because the "already
  // manages a team" check in the API can't stop two simultaneous requests.
  // Unassigned teams (NULL manager) are unaffected — Postgres treats NULLs as distinct.
  @@unique([tournamentId, managerUserId])
  @@index([tournamentId])
  @@index([managerUserId])
}

model Auction {
  id                      String   @id @default(cuid())
  tournamentId            String   @unique
  roomCode                String   @unique
  status                  String   @default("READY") // READY | LIVE | PAUSED | ENDED
  bidTimerSeconds         Int      @default(20)
  goingIntervalSeconds    Int      @default(8)
  minIncrement            Int      @default(5000)
  currentCategory         String?
  currentPlayerId         String?
  currentBidAmount        Int?
  currentBidTeamId        String?
  bidCount                Int      @default(0)
  // Re-auction policy. Default: the team that lost the player in a re-auction
  // may bid for them again. Organizers can switch this off per auction.
  allowPreviousOwnerRebid Boolean  @default(true)
  // false = a team can only be bid for by the manager the organizer linked or
  // invited; true = any logged-in manager may claim an unassigned team in the room.
  allowOpenClaim          Boolean  @default(false)
  // Auto Auction: when a lot closes, the engine brings the next random player
  // to the block by itself (after a short pause for the SOLD/UNSOLD call).
  autoAdvance             Boolean  @default(false)
  // Re-auction rounds: 1 = the main auction; each "Re-Auction Unsold &
  // Skipped Players" starts the next round with only those players.
  round                   Int      @default(1)
  createdAt               DateTime @default(now())

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bids       Bid[]
  events     AuctionEvent[]
}

model Bid {
  id         String   @id @default(cuid())
  auctionId  String
  playerId   String
  teamId     String
  teamName   String // denormalized for audit trail
  playerName String // denormalized for audit trail
  amount     Int
  cycle      Int      @default(0) // which auction cycle of the player this bid belongs to
  createdAt  DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([auctionId, playerId])
  @@index([auctionId, playerId, cycle])
  @@index([teamId])
}

// Append-only audit trail for money- and ownership-moving events.
// Rows are never updated or deleted: a re-auction adds RE_AUCTION + REFUND
// entries on top of the original SALE, so the full chain survives forever.
model AuctionEvent {
  id           String   @id @default(cuid())
  auctionId    String
  tournamentId String
  type         String // SALE | RE_AUCTION | REFUND | UNSOLD | SKIPPED
  cycle        Int      @default(0)
  playerId     String?
  playerName   String? // snapshot
  playerNumber Int?
  teamId       String?
  teamName     String? // snapshot
  amount       Int? // sale price, or the original sale price for RE_AUCTION
  refundAmount Int? // money actually returned to the team
  actorId      String? // organizer user id, null when the timer acted
  actorName    String?
  reason       String?
  createdAt    DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([auctionId, playerId, cycle])
}

model RoomParticipant {
  id        String   @id @default(cuid())
  auctionId String
  teamId    String?
  name      String
  role      String // ORGANIZER | MANAGER | VIEWER
  userId    String?
  online    Boolean  @default(false)
  lastSeen  DateTime @default(now())
  joinedAt  DateTime @default(now())

  @@unique([auctionId, role, name])
}

model Setting {
  key   String @id
  value String
}

// A player's self-registration through the public link. Kept apart from
// Player so nothing pending can ever reach the live auction pool; approving
// one creates the real Player row.
model PlayerRegistration {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  phone        String
  role         String
  previousTeam String?
  photoUrl     String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  playerId     String? // set on approval
  // Registration fee claimed by the player; verified by the organizer.
  feeAmount    Int?
  payMethod    String? // BKASH | NAGAD
  payTrxId     String?
  paySender    String?
  payStatus    String   @default("NONE") // NONE | CLAIMED | VERIFIED | REJECTED
  smsConsent   Boolean  @default(false)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // A Transaction ID can be claimed once per payment network.
  @@unique([payMethod, payTrxId])
  @@index([tournamentId, status])
}

// Uploaded images (player photos, team/tournament logos, banners), re-encoded
// to WebP by sharp. Stored in Postgres so they are covered by the same
// backups as everything else — fine at this scale (tens of KB each).
model Upload {
  id         String   @id @default(cuid())
  uploaderId String? // null for anonymous self-registration photos
  kind       String // PHOTO | LOGO | BANNER
  mime       String
  data       Bytes
  width      Int
  height     Int
  size       Int
  createdAt  DateTime @default(now())

  @@index([uploaderId])
}

// Request counters for rate limits on public endpoints (login, password reset,
// room-code lookups, joins, uploads…). In the database rather than in memory
// because the website runs on many short-lived serverless instances.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// One row per login. The session cookie names its row, so logging out revokes
// exactly that session (other devices stay signed in), and a copied cookie stops
// working the moment its session is revoked or expires.
model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Payment for a PRO tournament via manual bKash / Nagad: the organizer sends the
// money and submits the Transaction ID; an admin verifies and approves it.
// A financial record: it survives tournament or account deletion (snapshots below).
model Payment {
  id             String    @id @default(cuid())
  kind           String    @default("TOURNAMENT_PRO")
  tournamentId   String?
  tournamentName String // snapshot
  userId         String?
  payerName      String // snapshot
  amount         Int
  method         String // BKASH | NAGAD
  trxId          String
  senderNumber   String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([method, trxId])
  @@index([status, createdAt])
  @@index([tournamentId])
  @@index([userId])
}

// Extra people who help run a tournament. CO_ORGANIZER can manage everything
// except billing, staff and deletion; AUCTIONEER can only run the live room.
model TournamentStaff {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  role         String // CO_ORGANIZER | AUCTIONEER
  addedById    String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
}

// Outbox for SMS (and later WhatsApp). Rows are written by the web app and the
// auction service and delivered by the always-on auction service, so a send
// never blocks a request. dedupeKey stops the same message going out twice.
model Notification {
  id           String    @id @default(cuid())
  channel      String    @default("SMS")
  to           String
  body         String
  kind         String // REG_APPROVED | REG_REJECTED | AUCTION_REMINDER | PLAYER_SOLD | PAYMENT_APPROVED | ...
  tournamentId String?
  dedupeKey    String?   @unique
  status       String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  attempts     Int       @default(0)
  lastError    String?
  sendAfter    DateTime  @default(now())
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, sendAfter])
  @@index([tournamentId])
}

// First-party product analytics: server-side events only, no cookies or
// third-party trackers. Powers the admin funnel (sign-ups → auctions → Pro).
model AnalyticsEvent {
  id           String   @id @default(cuid())
  name         String
  userId       String?
  tournamentId String?
  props        Json?
  createdAt    DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

// League fixtures and results (after the auction). Teams are optional so
// knockout slots can wait for "Winner SF1"-style placeholders.
model Match {
  id              String    @id @default(cuid())
  tournamentId    String
  stage           String    @default("LEAGUE") // LEAGUE | GROUP | ROUND_OF_16 | QUARTER_FINAL | SEMI_FINAL | THIRD_PLACE | FINAL
  groupName       String?
  round           Int       @default(1)
  matchNumber     Int
  homeTeamId      String?
  awayTeamId      String?
  homeLabel       String? // placeholder shown until the team is known, e.g. "Winner SF1"
  awayLabel       String?
  scheduledAt     DateTime?
  venue           String?
  status          String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | ABANDONED | POSTPONED
  // Score: goals (football), runs (cricket) or points (other sports).
  homeScore       Int?
  awayScore       Int?
  // Cricket only: wickets lost and legal balls faced (net run rate).
  homeWickets     Int?
  awayWickets     Int?
  homeBalls       Int?
  awayBalls       Int?
  winnerTeamId    String?
  resultType      String? // NORMAL | TIE | NO_RESULT | WALKOVER
  resultNote      String? // e.g. "Alpha won by 5 wickets"
  playerOfMatchId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam   Team?             @relation("homeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam   Team?             @relation("awayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  stats      MatchPlayerStat[]

  @@unique([tournamentId, matchNumber])
  @@index([tournamentId, scheduledAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

// One player's numbers in one match; leaderboards add these up.
model MatchPlayerStat {
  id           String   @id @default(cuid())
  matchId      String
  playerId     String
  teamId       String?
  // Cricket
  runs         Int?
  ballsFaced   Int?
  fours        Int?
  sixes        Int?
  wickets      Int?
  ballsBowled  Int?
  runsConceded Int?
  catches      Int?
  // Football
  goals        Int?
  assists      Int?
  yellowCards  Int?
  redCards     Int?
  saves        Int?
  // Other sports
  points       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
}

// Sponsors shown on the stream overlay, live room, results / league pages and
// share cards (PRO).
model Sponsor {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  logoUrl      String?
  url          String?
  tier         String   @default("SPONSOR") // TITLE | ASSOCIATE | SPONSOR | PARTNER
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, sortOrder])
}

// Single-instance guard for the live auction service: only the holder of an
// unexpired lease serves rooms (mini-services/auction-service/lease.ts).
model ServiceLease {
  name       String   @id
  holder     String
  expiresAt  DateTime
  acquiredAt DateTime @default(now())
}
